+
+long FAST_FUNC gethostid(void)
+{
+	char buf[BB_COMPAT_BUF];
+	uint32_t id;
+	unsigned h = 0;
+	int i, fd;
+
+	/* glibc reads /etc/hostid; otherwise derive a stable value */
+	fd = open("/etc/hostid", O_RDONLY);
+	if (fd >= 0) {
+		if (read(fd, &id, sizeof(id)) == (ssize_t)sizeof(id)) {
+			close(fd);
+			return (long)id;
+		}
+		close(fd);
+	}
+	if (gethostname(buf, sizeof(buf)) != 0)
+		return 0;
+	buf[sizeof(buf) - 1] = '\0';
+	for (i = 0; buf[i]; i++)
+		h = h * 33 + (unsigned char)buf[i];
+	return (long)h;
