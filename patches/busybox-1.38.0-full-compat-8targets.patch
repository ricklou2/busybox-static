+/* bionic ships <glob.h> (types and flags) but no glob() at all, so hush's
+ * pathname expansion would not link. Provide a POSIX-ish implementation. */
+#if defined(__BIONIC__)
+#include <fnmatch.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <string.h>
+#include <stdlib.h>
+
+# ifndef GLOB_PERIOD
+#  define GLOB_PERIOD 0   /* GNU extension; bionic glob.h does not define it */
+# endif
+typedef struct { glob_t *g; int flags; } gctx;
+
+static int g_add(gctx *c, const char *path)
+{
+	glob_t *g = c->g;
+	char **nv;
+	size_t n = g->gl_pathc;
+	nv = realloc(g->gl_pathv, (n + 2) * sizeof(char *));
+	if (!nv) return GLOB_NOSPACE;
+	g->gl_pathv = nv;
+	nv[n] = strdup(path);
+	if (!nv[n]) return GLOB_NOSPACE;
+	nv[n + 1] = NULL;
+	g->gl_pathc = n + 1;
+	return 0;
+}
+
+static int is_dir(const char *p)
+{
+	struct stat st;
+	return stat(p, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+static int exists(const char *p)
+{
+	struct stat st;
+	return stat(p, &st) == 0;
+}
+
+static char *join(const char *pre, const char *comp, int dir)
+{
+	size_t pl = strlen(pre), cl = strlen(comp);
+	char *r = malloc(pl + cl + 2);
+	if (!r) return NULL;
+	memcpy(r, pre, pl);
+	memcpy(r + pl, comp, cl);
+	if (dir && (cl == 0 || comp[cl - 1] != '/')) {
+		r[pl + cl] = '/';
+		r[pl + cl + 1] = '\0';
+	} else {
+		r[pl + cl] = '\0';
+	}
+	return r;
+}
+
+static int walk_(gctx *c, const char *prefix, const char *rest, int depth);
+
+static int walk_meta(gctx *c, const char *prefix, const char *comp,
+		     const char *next, int last, int depth)
+{
+	DIR *d;
+	struct dirent *de;
+	int rc = 0;
+	const char *dp = *prefix ? prefix : ".";
+
+	d = opendir(dp);
+	if (!d)
+		return 0;
+	while ((de = readdir(d)) != NULL) {
+		char *full;
+
+		if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) {
+			if (strcmp(de->d_name, comp) != 0)
+				continue;
+		}
+		if (de->d_name[0] == '.'
+		 && !(c->flags & GLOB_PERIOD)
+		 && comp[0] != '.'
+		 && strcmp(de->d_name, ".") != 0 && strcmp(de->d_name, "..") != 0)
+			continue;
+		if (fnmatch(comp, de->d_name, 0) != 0)
+			continue;
+		full = join(prefix, de->d_name, !last);
+		if (!full) { rc = GLOB_NOSPACE; break; }
+		if (!last) {
+			if (is_dir(full)) {
+				int r = walk_(c, full, next, depth + 1);
+				if (r == GLOB_NOSPACE) { free(full); rc = r; break; }
+			}
+			free(full);
+		} else {
+			int r = g_add(c, full);
+			free(full);
+			if (r) { rc = r; break; }
+		}
+	}
+	closedir(d);
+	return rc;
+}
+
+static int walk_(gctx *c, const char *prefix, const char *rest, int depth)
+{
+	const char *slash;
+	char *comp;
+	size_t cl;
+	int last, rc = 0, meta;
+
+	if (depth > 32)
+		return GLOB_NOSPACE;
+
+	slash = strchr(rest, '/');
+	cl = slash ? (size_t)(slash - rest) : strlen(rest);
+	last = (slash == NULL);
+	comp = malloc(cl + 1);
+	if (!comp) return GLOB_NOSPACE;
+	memcpy(comp, rest, cl);
+	comp[cl] = '\0';
+
+	if (last && cl == 0) {          /* trailing '/' : the directory itself */
+		if (exists(prefix))
+			rc = g_add(c, prefix);
+		free(comp);
+		return rc;
+	}
+
+	meta = (strpbrk(comp, "*?[") != NULL);
+	if (!meta) {
+		char *full = join(prefix, comp, !last);
+		if (!full) { free(comp); return GLOB_NOSPACE; }
+		if (!last) {
+			if (is_dir(full))
+				rc = walk_(c, full, slash + 1, depth + 1);
+		} else if (exists(full)) {
+			rc = g_add(c, full);
+		}
+		free(full);
+		free(comp);
+		return rc;
+	}
+
+	rc = walk_meta(c, prefix, comp, last ? NULL : slash + 1, last, depth);
+	free(comp);
+	return rc;
+}
+
+static int cmp_str(const void *a, const void *b)
+{
+	return strcmp(*(const char *const *)a, *(const char *const *)b);
+}
+
+int glob(const char *pattern, int flags,
+	 int (*errfunc)(const char *, int), glob_t *pglob)
+{
+	gctx c;
+	char *prefix;
+	const char *rest;
+	int rc;
+
+	if (!(flags & GLOB_APPEND)) {
+		pglob->gl_pathc = 0;
+		pglob->gl_pathv = NULL;
+	}
+	c.g = pglob;
+	c.flags = flags;
+	if (pattern[0] == '/') {
+		prefix = strdup("/");
+		rest = pattern + 1;
+	} else {
+		prefix = strdup("");
+		rest = pattern;
+	}
+	if (!prefix)
+		return GLOB_NOSPACE;
+	rc = walk_(&c, prefix, rest, 0);
+	free(prefix);
+	if (rc == GLOB_NOSPACE)
+		return rc;
+	if (pglob->gl_pathc == 0) {
+		if (flags & GLOB_NOCHECK) {
+			if (g_add(&c, pattern))
+				return GLOB_NOSPACE;
+		} else
+			return GLOB_NOMATCH;
+	}
+	if (!(flags & GLOB_NOSORT))
+		qsort(pglob->gl_pathv, pglob->gl_pathc, sizeof(char *), cmp_str);
+	return 0;
+}
+
+void globfree(glob_t *pglob)
+{
+	size_t i;
+
+	if (!pglob->gl_pathv)
+		return;
+	for (i = 0; i < pglob->gl_pathc; i++)
+		free(pglob->gl_pathv[i]);
+	free(pglob->gl_pathv);
+	pglob->gl_pathv = NULL;
+	pglob->gl_pathc = 0;
+}
