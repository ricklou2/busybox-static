diff -ruN '--exclude=.config' '--exclude=busybox' '--exclude=*.o' '--exclude=*.a' '--exclude=.*.cmd' '--exclude=include/autoconf.h' '--exclude=include/build' '--exclude=.config.old' a/include/regex.h b/include/regex.h
