+int ether_hostton(const char *hostname, struct ether_addr *addr)
+{
+	char line[128];
+	FILE *fp = fopen("/etc/ethers", "r");
+
+	if (!fp)
+		return -1;
+	while (fgets(line, sizeof(line), fp)) {
+		char *mac = skip_whitespace(line);
+		char *name, *end;
+		struct ether_addr *ea;
+
+		if (mac[0] == '#' || mac[0] == '\0')
+			continue;
+		name = strchr(mac, ' ');
+		if (!name)
+			name = strchr(mac, '\t');
+		if (!name)
+			continue;
+		*name++ = '\0';
+		name = skip_whitespace(name);
+		end = name + strlen(name);
+		while (end > name && (unsigned char)end[-1] <= ' ')
+			end--;
+		*end = '\0';
+		if (strcmp(name, hostname) != 0)
+			continue;
+		ea = ether_aton(mac);
+		if (!ea)
+			continue;
+		memcpy(addr, ea, sizeof(*addr));
+		fclose(fp);
+		return 0; /* 0 = found, matches busybox's check */
+	}
+	fclose(fp);
+	return -1;
+}
