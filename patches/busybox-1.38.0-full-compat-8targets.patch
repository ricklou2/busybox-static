+/* bionic has no getlogin_r(): Android has no utmp/login session.
+ * Emulate via LOGNAME / getpwuid(uid), which is what logname applet wants. */
+int getlogin_r(char *buf, size_t bufsize)
+{
+	const char *name = getenv("LOGNAME");
+	struct passwd *pw;
+
+	if (!name || !*name) {
+		pw = getpwuid(getuid());
+		name = pw ? pw->pw_name : NULL;
+	}
+	if (!name || !*name)
+		return ENOENT;
+	if (strlen(name) >= bufsize)
+		return ERANGE;
+	strcpy(buf, name);
+	return 0;
