+/* ---------- GNU regex compatibility (bionic / musl) ---------- */
+#if !BB_LIBC_HAS_GNU_REGEX
+#include <regex.h>
+
+unsigned re_syntax_options;
+
+const char *re_compile_pattern(const char *pattern, size_t length,
+			       struct re_pattern_buffer *bufp)
+{
+	char *pat;
+	int cflags = 0;
+	int r;
+
+	pat = xmalloc(length + 1);
+	memcpy(pat, pattern, length);
+	pat[length] = '\0';
+
+	if (re_syntax_options & RE_NO_BK_PARENS)
+		cflags |= REG_EXTENDED;
+	if ((re_syntax_options & RE_ICASE) || bufp->translate)
+		cflags |= REG_ICASE;
+
+	r = regcomp(&bufp->rx, pat, cflags);
+	free(pat);
+	bufp->compiled = (r == 0);
+	return (r == 0) ? NULL : "Invalid regular expression";
+}
+
+int re_search(struct re_pattern_buffer *bufp, const char *string, int length,
+	      int start, int range, struct re_registers *regs)
+{
+	regmatch_t pm[10];
+	int i, rc;
+	int eflags = 0;
+
+	(void)range;
+	if (!bufp->compiled || start < 0 || start > length)
+		return -1;
+
+	if (bufp->not_bol)
+		eflags |= REG_NOTBOL;
+	if (bufp->not_eol)
+		eflags |= REG_NOTEOL;
+
+	rc = regexec(&bufp->rx, string + start, 10, pm, eflags);
+	if (rc != 0)
+		return -1;
+
+	if (regs) {
+		if (!regs->start) {
+			regs->start = xmalloc(10 * sizeof(regoff_t));
+			regs->end = xmalloc(10 * sizeof(regoff_t));
+		}
+		regs->num_regs = 10;
+		for (i = 0; i < 10; i++) {
+			if (pm[i].rm_so < 0) {
+				regs->start[i] = -1;
+				regs->end[i] = -1;
+			} else {
+				regs->start[i] = start + pm[i].rm_so;
+				regs->end[i] = start + pm[i].rm_eo;
+			}
+		}
+	}
+	return start + (int)pm[0].rm_so;
+}
